{
  "name": "@relay-ai/sdk",
  "version": "1.0.0",
  "description": "TypeScript client for the Relay Gateway — OpenAI-compatible chat plus Relay's own request metadata and control plane.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetan-01-source/relay.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/chetan-01-source/relay/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/chetan-01-source/relay/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../api/openapi/openapi.json -o src/generated/api-types.ts"
  },
  "keywords": [
    "llm",
    "gateway",
    "openai",
    "proxy",
    "relay"
  ],
  "devDependencies": {
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
