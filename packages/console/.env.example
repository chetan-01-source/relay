# Relay Console — env. Copy to `.env.local` (gitignored) and fill.
#   cp packages/console/.env.example packages/console/.env.local
# See docs/SETUP.md §2 step 3. The console runs on :3100; the gateway owns :3000.

# ─── Logto sign-in (Traditional web app) ────────────────────────────────────────
# Create the app in the Logto admin console (http://localhost:3002 → Applications →
# Traditional Web, name it relay-console) and set its redirect URI to
# http://localhost:3100/callback. Then copy the app's ID + secret here.
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_APP_ID=                       # the Traditional web app's App ID
LOGTO_APP_SECRET=                   # the Traditional web app's App Secret
LOGTO_BASE_URL=http://localhost:3100
LOGTO_COOKIE_SECRET=                # generate: openssl rand -base64 24

# ─── Control-plane API client ───────────────────────────────────────────────────
# Where the gateway's /api/* lives, and the resource the access token is minted for.
# RELAY_API_RESOURCE MUST equal the server's RELAY_LOGTO_JWT_AUDIENCE.
RELAY_API_BASE_URL=http://localhost:3000
RELAY_API_RESOURCE=https://relay.gateway/api
