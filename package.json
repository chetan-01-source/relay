{
  "name": "relay",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "build": "turbo build",
    "dev": "turbo dev",
    "dep-check": "depcruise packages --config .dependency-cruiser.cjs",
    "gen:postman": "node scripts/gen-postman.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": ">=0.28.1",
      "vite": ">=6.4.3",
      "postcss": ">=8.5.23",
      "js-yaml@4.2.0": "4.3.1",
      "fast-uri@3.1.3": "3.1.5",
      "fast-uri@4.1.0": "4.1.2",
      "sharp@0.34.5": "0.35.0",
      "find-my-way": ">=9.7.0",
      "next@15.5.20": "15.5.21",
      "@fastify/static": ">=10.1.2",
      "brace-expansion": ">=5.0.9",
      "minimatch": ">=10.0.0",
      "js-yaml@4.3.0": "4.3.1",
      "fast-uri@3.1.4": "3.1.5",
      "fast-uri@4.1.1": "4.1.2",
      "nanoid@3.3.16": "3.3.18"
    }
  }
}
