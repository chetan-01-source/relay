# Relay — hosted service. Copy to `.env`, fill in, then `docker compose up -d`.
# See docs/launch-playbook.md for the full walkthrough.
#
# chmod 600 .env — it holds every secret the service has.

# ── Images (published, signed, multi-arch: works on Oracle's ARM) ─────────────
RELAY_SERVER_IMAGE=ghcr.io/chetan-01-source/relay:latest
RELAY_CONSOLE_IMAGE=ghcr.io/chetan-01-source/relay-console:latest

# ── Database ──────────────────────────────────────────────────────────────────
# Managed Postgres (Neon / Supabase / Aiven). Leave these BLANK and start the stack
# with `--profile local-db` to run Postgres on the box instead.
#
#  • RELAY_DATABASE_URL            — the RLS-bound `relay_app` role. A POOLED endpoint
#                                    is fine and preferred (Neon: host WITH `-pooler`).
#  • RELAY_MIGRATION_DATABASE_URL  — the OWNER role, and it MUST be a DIRECT endpoint:
#                                    migrations take a session-level advisory lock that
#                                    a transaction pooler silently drops.
#  • LOGTO_DB_URL                  — Logto's own database. Never share Relay's.
RELAY_DATABASE_URL=
RELAY_MIGRATION_DATABASE_URL=
LOGTO_DB_URL=

# Only used by the `local-db` profile.
#   openssl rand -base64 24
POSTGRES_PASSWORD=
RELAY_APP_PASSWORD=
#   openssl rand -base64 32   (MUST decode to exactly 32 bytes)
RELAY_MASTER_KEY=
#   openssl rand -base64 32
LOGTO_COOKIE_SECRET=

# ── Public origins (https, no trailing slash) ─────────────────────────────────
# These are baked into tokens and redirect URLs. A wrong value here is a redirect
# loop at sign-in, not an error message.
RELAY_CONSOLE_URL=https://app.example.com
LOGTO_ENDPOINT=https://auth.example.com
LOGTO_ADMIN_ENDPOINT=https://auth-admin.example.com

# ── Logto apps (created in the Logto admin console — see the playbook §7) ─────
# Traditional web app, for console sign-in:
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Machine-to-machine app, for tenant onboarding. Without both, onboarding returns 503.
RELAY_LOGTO_M2M_APP_ID=
RELAY_LOGTO_M2M_APP_SECRET=
# Must match on both the gateway and the console.
RELAY_API_RESOURCE=https://relay.gateway/api

# ── Ingress ───────────────────────────────────────────────────────────────────
# Cloudflare Zero Trust → Networks → Tunnels → create → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Edition ───────────────────────────────────────────────────────────────────
# `oss` while v1 is free for everyone: unlimited limits, no quota enforced.
# Flip to `cloud` (here only — the console reads the same variable) to enforce plans.
RELAY_EDITION=oss

# ── Upstream + cache ──────────────────────────────────────────────────────────
RELAY_UPSTREAM_URL=https://api.openai.com
RELAY_CACHE_TTL_S=60

# ── Background worker cadence ─────────────────────────────────────────────────
# Two workers poll Postgres on a timer whether or not traffic is flowing: the rollup
# rebuild and the notification outbox. At the defaults (60s / 15s) a scale-to-zero
# database NEVER sleeps, which on Neon's free plan exhausts the monthly compute
# allowance around day 16. 15-minute intervals leave gaps longer than Neon's 5-minute
# idle timeout, so it can suspend between ticks. See docs/release-v1.md §4.3.
# On a local or always-on database, delete these two and keep the responsive defaults.
RELAY_ROLLUP_INTERVAL_MS=900000
RELAY_NOTIFY_INTERVAL_MS=900000
# The metering flush is different: it returns without querying when the queue is empty,
# so it costs nothing while idle. Leave it responsive — raising it only widens the window
# in which a crash loses buffered usage events.
RELAY_METERING_FLUSH_INTERVAL_MS=2000

# ── Mail — REQUIRED before inviting a real tenant ─────────────────────────────
# With no host, the gateway records what it would have sent and delivers nothing,
# so invitations silently never arrive. Any SMTP provider works.
RELAY_SMTP_HOST=
RELAY_SMTP_PORT=587
RELAY_SMTP_SECURE=false
RELAY_SMTP_USER=
RELAY_SMTP_PASSWORD=
RELAY_SMTP_FROM=Relay <noreply@example.com>
