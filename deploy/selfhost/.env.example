# Relay self-host — copy to `.env` and fill in. `docker compose up -d` reads it.
# The image refs are pinned to a signed release by `make selfhost-bundle`; override the tag to upgrade.

# ── Images (published, signed GHCR release) ───────────────────────────────────
RELAY_SERVER_IMAGE=ghcr.io/chetan-01-source/relay:latest
RELAY_CONSOLE_IMAGE=ghcr.io/chetan-01-source/relay-console:latest

# ── Secrets (REQUIRED — generate strong values) ───────────────────────────────
# openssl rand -base64 24
POSTGRES_PASSWORD=change-me
RELAY_APP_PASSWORD=change-me
# The envelope-encryption master key. MUST be 32 bytes base64:  openssl rand -base64 32
RELAY_MASTER_KEY=change-me-32-byte-base64

# ── Upstream provider (where the gateway forwards on a cache miss) ─────────────
# Default fallback; per-provider credentials configured in the console override this.
RELAY_UPSTREAM_URL=https://api.openai.com
# ── Edition (ADR-0014 · docs/editions.md) ────────────────────────────────────
# MVP-FREE: pinned to `oss` for the trial period — Relay is free for everyone right now, so no
# quota may bite and no capability may be withheld. The plan layer is fully built and tested; set
# this to `cloud` (and uncomment the pricing surfaces in the console — grep MVP-FREE) to start
# enforcing tiers.
#
# oss   — every organization resolves to the built-in `self_hosted` plan: every limit unlimited,
#         every capability on, every quota check a no-op.
# cloud — plans come from the `plans` table and quotas are enforced.
RELAY_EDITION=oss

RELAY_CACHE_TTL_S=0

# ── Console sign-in via Logto (optional — the data plane works with virtual keys alone) ──
# See docs/self-hosting.md to stand up Logto and fill these.
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=
LOGTO_BASE_URL=http://localhost:3100
RELAY_API_RESOURCE=https://relay.gateway/api
