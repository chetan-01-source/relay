# Relay Gateway — server + infra env. Copy to `.env` (gitignored) and fill.
#   cp deploy/compose/.env.example deploy/compose/.env
# Compose reads this file for the datastores; the gateway CLIs get RELAY_* from it (make loads it).
# See docs/SETUP.md §2 for the full step-by-step. NEVER commit the filled `.env`.

# ─────────────────────────────────────────────────────────────────────────────
# 1 · Datastore secrets (compose) — set any strong local values
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-locally        # postgres superuser (migrations, seed, pgweb)
RELAY_APP_PASSWORD=change-me-locally       # relay_app / relay_admin roles (runtime, RLS applies)
MINIO_ROOT_USER=relay
MINIO_ROOT_PASSWORD=change-me-locally

# ─────────────────────────────────────────────────────────────────────────────
# 2 · Gateway connection strings — the two passwords above MUST match these URLs
# ─────────────────────────────────────────────────────────────────────────────
# runtime: RLS-bound non-superuser role (uses RELAY_APP_PASSWORD)
RELAY_DATABASE_URL=postgres://relay_app:change-me-locally@localhost:5432/relay
# migrations/seed: superuser (uses POSTGRES_PASSWORD) — CREATE / FORCE RLS / CREATE POLICY
RELAY_MIGRATION_DATABASE_URL=postgres://postgres:change-me-locally@localhost:5432/relay
RELAY_VALKEY_URL=redis://localhost:6379
RELAY_UPSTREAM_URL=http://localhost:8080   # Phase-1 hardcoded upstream → mockllm

# ─────────────────────────────────────────────────────────────────────────────
# 3 · Crypto — REQUIRED (crypto + seed fail without it)
# ─────────────────────────────────────────────────────────────────────────────
RELAY_MASTER_KEY=                          # generate: openssl rand -base64 32  (32-byte envelope KEK)

# ─────────────────────────────────────────────────────────────────────────────
# 4 · Logto (control-plane auth). ENDPOINT is known; M2M_* come from SETUP.md §2
#     step 2 (create the relay-server M2M app), then run `make seed-auth`.
# ─────────────────────────────────────────────────────────────────────────────
RELAY_LOGTO_ENDPOINT=http://localhost:3001
RELAY_LOGTO_M2M_APP_ID=                     # from the Logto Machine-to-Machine app
RELAY_LOGTO_M2M_APP_SECRET=
# The API resource the console's token is minted for. Leave as-is unless you change the indicator;
# it MUST equal RELAY_API_RESOURCE in packages/console/.env.local.
RELAY_LOGTO_JWT_AUDIENCE=https://relay.gateway/api

# ── Edition (ADR-0014 · docs/editions.md) ────────────────────────────────────
# MVP-FREE: pinned to `oss` for the trial period — Relay is free for everyone right now, so no
# quota may bite and no capability may be withheld. The plan layer is fully built and tested; set
# this to `cloud` (and uncomment the pricing surfaces in the console — grep MVP-FREE) to start
# enforcing tiers.
#
# oss   — every organization resolves to the built-in `self_hosted` plan: every limit unlimited,
#         every capability on, every quota check a no-op.
# cloud — plans come from the `plans` table and quotas are enforced.
RELAY_EDITION=oss

RELAY_CACHE_TTL_S=0                         # exact-cache TTL in seconds. 0 = OFF (default).
#   The per-route toggle in the console and the cache.exact entitlement BOTH still apply, but this
#   is the master switch — leave it 0 and no response is ever cached. Try 300 to enable.
RELAY_CACHE_MAX_BYTES=262144                # bodies over this cap are not cached
RELAY_METERING_QUEUE_MAX=10000              # bounded in-process ring queue (drop-oldest when full)
RELAY_METERING_FLUSH_INTERVAL_MS=2000       # flush usage events → Postgres
RELAY_ROLLUP_INTERVAL_MS=60000              # recompute hourly usage_rollups
RELAY_SHUTDOWN_TIMEOUT_MS=15000             # max drain time on SIGTERM before forcing exit (Day 14)

# ─────────────────────────────────────────────────────────────────────────────
# 6 · Optional overrides (all have safe defaults — omit unless you need them)
# ─────────────────────────────────────────────────────────────────────────────
# RELAY_PORT=3000                           # data plane
# RELAY_INTERNAL_PORT=9090                  # health + metrics
# RELAY_LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace

# ─────────────────────────────────────────────────────────────────────────────
# 7 · Notifications (email) — Day 16
#
#   RELAY_SMTP_HOST is the MASTER SWITCH. Leave it unset and the gateway uses a
#   console sender: notifications are still queued, still rendered, and still
#   reach 'sent' in the delivery log — but NOTHING is emailed. That is the safe
#   local default; a dev box must not mail a tenant's real members while you are
#   testing a budget breach.
#
#   Set the host only when you actually want delivery. A tenant can override all
#   of this with its own SMTP under Settings -> Notifications in the console;
#   these values are the platform fallback for orgs that have not.
#
#   Local testing without sending real mail: run Mailpit or MailHog and point
#   RELAY_SMTP_HOST at it (Mailpit: host=localhost port=1025, web UI on :8025).
# ─────────────────────────────────────────────────────────────────────────────
# RELAY_SMTP_HOST=localhost                 # unset = no email is sent (default)
# RELAY_SMTP_PORT=587                       # 1025 for Mailpit/MailHog, 465 if secure
# RELAY_SMTP_SECURE=false                   # true = implicit TLS (usually port 465)
# RELAY_SMTP_USER=                          # omit for a local relay that needs no auth
#   QUOTE any value containing spaces. This file is sourced by the shell (`set -a; . .env`), so an
#   unquoted value is cut at the first space and the rest is run as a command. Gmail DISPLAYS its
#   App Password as 4 groups of 4 ("abcd efgh ijkl mnop") — paste that raw and the shell keeps only
#   "abcd", which Gmail rejects with 535-5.7.8 BadCredentials. Strip the spaces AND quote it:
#     RELAY_SMTP_PASSWORD="abcdefghijklmnop"
#   A Gmail App Password is 16 characters and REQUIRES 2-Step Verification on the account; a normal
#   account password will always be rejected for SMTP.
# RELAY_SMTP_PASSWORD=
#   IMPORTANT — two hostnames for ONE mail server. The gateway runs on your host and reaches
#   Mailpit on localhost; Logto runs inside Docker and must use the compose SERVICE NAME. Getting
#   this wrong is silent: Logto stores the connector happily and only fails when a user tries to
#   sign up ("configuration not done"), because `localhost` inside that container is Logto itself.
RELAY_LOGTO_SMTP_HOST=mailpit               # how LOGTO reaches the mail server (compose service)
RELAY_SMTP_FROM=relay@localhost             # envelope From for platform-sent mail
#   RELAY_CONSOLE_URL is also the base of every ORGANIZATION INVITATION link
#   (${RELAY_CONSOLE_URL}/invitations/<id>) — an invitee cannot join without it,
#   and pointing it at localhost mails your users a link to their own machine.
RELAY_CONSOLE_URL=http://localhost:3100     # deep-links in emails point here
RELAY_NOTIFY_INTERVAL_MS=15000              # delivery worker poll interval
